# Airtable — base "Rrentals" (appQHr080xm4sCku3)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appQHr080xm4sCku3

# Contraseña única para entrar a la app (no hay usuarios múltiples)
APP_PASSWORD=

# Clave para firmar la cookie de sesión. Generar con: openssl rand -base64 32
SESSION_SECRET=

# API de Anthropic para la función "preguntale a Claude"
ANTHROPIC_API_KEY=

# Google Drive - subida de fotos de licencia del formulario público (ver /sop
# en la app para cómo regenerar GOOGLE_OAUTH_REFRESH_TOKEN si vence)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Vercel Blob - backup del formulario público si Drive/Airtable fallan a mitad
# de camino (se crea solo al conectar un Blob store en el proyecto de Vercel)
BLOB_READ_WRITE_TOKEN=
