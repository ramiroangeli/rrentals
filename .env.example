# Airtable — base "Rrentals" (appQHr080xm4sCku3)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appQHr080xm4sCku3

# Contraseña única para entrar a la app (no hay usuarios múltiples)
APP_PASSWORD=

# Clave para firmar la cookie de sesión. Generar con: openssl rand -base64 32
SESSION_SECRET=

# API de Anthropic para la función "preguntale a Claude"
ANTHROPIC_API_KEY=

# Vercel Blob (store privado) - fotos de licencia, copia firmada del contrato,
# y backup del formulario público si Airtable falla a mitad de camino (se crea
# solo al conectar un Blob store en el proyecto de Vercel)
BLOB_READ_WRITE_TOKEN=
